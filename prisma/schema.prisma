generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
}

// ============ MASTER / SAAS ============

model SuperAdmin {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String
  phone       String?
  roleId      String?
  role        AdminRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive    Boolean   @default(true)
  isPrimary   Boolean   @default(false)
  totpSecret  String?
  totpEnabled Boolean   @default(false)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  activityLogs    PlatformActivityLog[]
  assignedTickets SupportTicket[] @relation("AssignedTickets")
}

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  permissions Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admins SuperAdmin[]
}

model PlatformFeature {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  module      String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([module, sortOrder])
  @@index([isActive, sortOrder])
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String   @default("percentage")
  discountValue Decimal  @db.Decimal(12, 2)
  expiryDate    DateTime?
  usageLimit    Int?
  usedCount     Int      @default(0)
  packageId     String?
  package       SubscriptionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlatformAnnouncement {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  status      String    @default("draft")
  targetType  String    @default("all")
  targetIds   Json?
  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PlatformBroadcast {
  id         String    @id @default(cuid())
  title      String
  message    String    @db.Text
  channel    String    @default("system")
  targetType String    @default("all")
  targetIds  Json?
  status     String    @default("draft")
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model SubscriptionInvoice {
  id             String    @id @default(cuid())
  tenantId       String
  subscriptionId String?
  invoiceNo      String    @unique
  amount         Decimal   @db.Decimal(12, 2)
  tax            Decimal   @default(0) @db.Decimal(12, 2)
  discount       Decimal   @default(0) @db.Decimal(12, 2)
  total          Decimal   @db.Decimal(12, 2)
  status         String    @default("unpaid")
  dueDate        DateTime?
  paidAt         DateTime?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
}

model PlatformActivityLog {
  id        String   @id @default(cuid())
  adminId   String?
  admin     SuperAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminName String?
  action    String
  module    String
  details   String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([module, createdAt])
  @@index([adminId])
}

model TenantDatabaseBackup {
  id        String   @id @default(cuid())
  tenantId  String
  fileName  String
  filePath  String?
  sizeBytes Int?
  status    String   @default("success")
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model SubscriptionPackage {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?  @db.Text
  price         Decimal  @db.Decimal(12, 2)
  billingCycle  String   @default("monthly") // monthly, yearly
  trialDays     Int      @default(0)
  maxUsers      Int      @default(2)
  maxBranches   Int      @default(1)
  maxProducts   Int      @default(500)
  maxInvoices   Int      @default(1000)
  graceDays       Int      @default(7)
  yearlyPrice     Decimal? @db.Decimal(12, 2)
  maxCustomers    Int      @default(500)
  maxSuppliers    Int      @default(200)
  storageLimitMb  Int      @default(1024)
  features        Json     @default("[]")
  moduleFlags     Json     @default("{}")
  isPopular       Boolean  @default(false)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]
  tenants       Tenant[]
  coupons       Coupon[]
}

model Tenant {
  id            String   @id @default(cuid())
  name          String
  ownerName     String?
  slug          String   @unique
  email         String
  phone         String?
  address       String?  @db.Text
  logo          String?
  status        TenantStatus @default(PENDING)
  loginBlocked  Boolean  @default(false)
  dbName        String?
  dbProvisioned Boolean  @default(false)
  settings      Json     @default("{}")
  packageId     String?
  package       SubscriptionPackage? @relation(fields: [packageId], references: [id])
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  users           User[]
  branches        Branch[]
  roles           Role[]
  categories      ProductCategory[]
  brands          Brand[]
  units           Unit[]
  products        Product[]
  customerGroups  CustomerGroup[]
  customers       Customer[]
  suppliers       Supplier[]
  purchases       Purchase[]
  sales           Sale[]
  expenses        Expense[]
  expenseCategories ExpenseCategory[]
  stockMovements  StockMovement[]
  stockTransfers  StockTransfer[]
  purchaseReturns PurchaseReturn[]
  saleReturns     SaleReturn[]
  supportTickets  SupportTicket[]
  customerPayments CustomerPayment[]
  supplierPayments SupplierPayment[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  ecommerceSettings EcommerceSetting[]
  onlineOrders     OnlineOrder[]
  loginLogs        LoginLog[]
  apiKeys          TenantApiKey[]
}

model TenantApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  keyPrefix  String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

model LoginLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  email     String
  success   Boolean
  ip        String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
}

model EcommerceSetting {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform       String    @default("woocommerce")
  storeUrl       String
  consumerKey    String    @db.Text
  consumerSecret String    @db.Text
  isActive       Boolean   @default(false)
  syncProducts    Boolean   @default(true)
  syncStock       Boolean   @default(true)
  syncOrders      Boolean   @default(true)
  syncCustomers   Boolean   @default(false)
  syncDirection   String    @default("inbound")
  webhookSecret   String?
  lastProductSync DateTime?
  lastOrderSync   DateTime?
  lastCustomerSync DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, platform])
}

model OnlineOrder {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId    String
  platform      String   @default("woocommerce")
  orderNumber   String
  customerName  String?
  customerEmail String?
  total         Decimal  @db.Decimal(12, 2)
  status        String
  saleId        String?
  orderDate     DateTime
  syncedAt      DateTime @default(now())

  @@unique([tenantId, platform, externalId])
  @@index([tenantId, orderDate])
}

model ActivityLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String?
  action    String
  module    String
  details   String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([module])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String   @default("info")
  title     String
  message   String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId, isRead])
  @@index([tenantId, type])
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  INACTIVE
}

model Subscription {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packageId String
  package   SubscriptionPackage @relation(fields: [packageId], references: [id])
  startDate DateTime @default(now())
  endDate   DateTime
  status    SubscriptionStatus @default(ACTIVE)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments SubscriptionPayment[]
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

model SubscriptionPayment {
  id             String   @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Decimal  @db.Decimal(12, 2)
  method         String?
  transactionId  String?
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime @default(now())
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model SupportTicket {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject         String
  message         String   @db.Text
  category        String?
  status          String   @default("open")
  priority        String   @default("medium")
  assignedAdminId String?
  assignedAdmin   SuperAdmin? @relation("AssignedTickets", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  replies SupportTicketReply[]
}

model SupportTicketReply {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType String   @default("admin")
  authorName String
  message    String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

model BillingCheckout {
  id             String   @id @default(cuid())
  tenantId       String
  subscriptionId String?
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("USD")
  gateway        String
  externalRef    String?
  status         String   @default("pending")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, status])
  @@index([externalRef])
}

// ============ TENANT DATA ============

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  permissions Json     @default("[]")
  branchIds   Json?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@unique([tenantId, name])
}

model User {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId    String?
  role      Role?    @relation(fields: [roleId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  email     String
  password  String
  name              String
  phone             String?
  profileImage      String?
  extraPermissions  Json?
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  deletedAt           DateTime?
  userType            UserType  @default(TENANT)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sales            Sale[]
  purchases        Purchase[]
  stockMovements   StockMovement[]
  stockTransfersRequested StockTransfer[] @relation("TransferRequestedBy")
  stockTransfersApproved  StockTransfer[] @relation("TransferApprovedBy")
  managedBranches  Branch[] @relation("BranchManager")

  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

enum UserType {
  SUPER_ADMIN
  TENANT
}

model Branch {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  address        String?   @db.Text
  contactPerson  String?
  phone          String?
  email          String?
  openingBalance Decimal?  @db.Decimal(12, 2)
  managerId      String?
  manager        User?     @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  settings       Json?
  isMain         Boolean   @default(false)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users          User[]
  products       Product[]
  sales          Sale[]
  purchases      Purchase[]
  stockMovements StockMovement[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")
  expenses       Expense[]

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
}

model ProductCategory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  image     String?
  parentId  String?
  parent    ProductCategory? @relation("CategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryTree")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
}

model Brand {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  logo        String?
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@unique([tenantId, name])
}

model Unit {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  shortName String?
  unitType  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([tenantId, name])
}

model Product {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  categoryId    String?
  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?   @relation(fields: [brandId], references: [id])
  unitId        String?
  unit          Unit?    @relation(fields: [unitId], references: [id])
  name          String
  sku           String?
  barcode       String?
  purchasePrice Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice  Decimal  @default(0) @db.Decimal(12, 2)
  wholesalePrice Decimal? @db.Decimal(12, 2)
  taxRate       Decimal  @default(0) @db.Decimal(5, 2)
  stockQty      Decimal  @default(0) @db.Decimal(12, 3)
  reorderLevel  Decimal  @default(0) @db.Decimal(12, 3)
  expiryDate    DateTime?
  batchNo       String?
  serialNo      String?
  image         String?
  description   String?  @db.Text
  status        ProductStatus @default(ACTIVE)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  saleItems     SaleItem[]
  purchaseItems     PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleReturnItems     SaleReturnItem[]
  stockMovements    StockMovement[]
  stockTransfers    StockTransfer[]

  @@index([tenantId, barcode])
  @@index([tenantId, sku])
  @@index([tenantId, name])
  @@index([tenantId, deletedAt])
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model CustomerGroup {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?  @db.Text
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customers Customer[]

  @@unique([tenantId, name])
}

model Customer {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId        String?
  group          CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name           String
  phone          String?
  email          String?
  address        String?  @db.Text
  customerType   String   @default("retail")
  openingBalance Decimal  @default(0) @db.Decimal(12, 2)
  creditLimit    Decimal  @default(0) @db.Decimal(12, 2)
  loyaltyPoints  Int      @default(0)
  dateOfBirth    DateTime?
  status         String   @default("active")
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales        Sale[]
  payments     CustomerPayment[]
  saleReturns  SaleReturn[]

  @@index([tenantId, phone])
  @@index([tenantId, groupId])
  @@index([tenantId, deletedAt])
}

model CustomerPayment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saleId      String?
  sale        Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  amount          Decimal  @db.Decimal(12, 2)
  method          String   @default("cash")
  transactionRef  String?
  attachment      String?
  status          String   @default("completed")
  reversedAt      DateTime?
  reversalReason  String?
  paymentDate     DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())

  @@index([tenantId, customerId])
  @@index([saleId])
}

model Supplier {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  companyName    String?
  phone          String?
  email          String?
  address        String?  @db.Text
  openingBalance Decimal  @default(0) @db.Decimal(12, 2)
  paymentTerms   String?
  status         String   @default("active")
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]
  payments        SupplierPayment[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model SupplierPayment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseId      String?
  amount          Decimal  @db.Decimal(12, 2)
  method          String   @default("cash")
  transactionRef  String?
  attachment      String?
  status          String   @default("completed")
  reversedAt      DateTime?
  reversalReason  String?
  paymentDate     DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())

  @@index([tenantId, supplierId])
}

model Purchase {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId           String?
  branch             Branch?  @relation(fields: [branchId], references: [id])
  supplierId         String?
  supplier           Supplier? @relation(fields: [supplierId], references: [id])
  userId             String?
  user               User?    @relation(fields: [userId], references: [id])
  invoiceNo          String
  supplierInvoiceNo  String?
  purchaseDate       DateTime @default(now())
  subtotal           Decimal  @default(0) @db.Decimal(12, 2)
  discount           Decimal  @default(0) @db.Decimal(12, 2)
  tax                Decimal  @default(0) @db.Decimal(12, 2)
  shippingCost       Decimal  @default(0) @db.Decimal(12, 2)
  total              Decimal  @default(0) @db.Decimal(12, 2)
  paidAmount         Decimal  @default(0) @db.Decimal(12, 2)
  dueAmount          Decimal  @default(0) @db.Decimal(12, 2)
  paymentMethod      String?  @default("cash")
  paymentStatus      PurchasePaymentStatus @default(DUE)
  status             PurchaseStatus @default(COMPLETED)
  cancellationReason String?  @db.Text
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items    PurchaseItem[]
  returns  PurchaseReturn[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, purchaseDate])
  @@index([supplierId])
  @@index([tenantId, status])
}

enum PurchasePaymentStatus {
  PAID
  PARTIAL
  DUE
}

enum PurchaseStatus {
  DRAFT
  COMPLETED
  RETURNED
  CANCELLED
}

model PurchaseReturn {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseId   String
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  returnNo     String
  returnDate   DateTime @default(now())
  status       PurchaseReturnStatus @default(DRAFT)
  refundAmount Decimal  @default(0) @db.Decimal(12, 2)
  reason       String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items PurchaseReturnItem[]

  @@unique([tenantId, returnNo])
  @@index([tenantId, returnDate])
  @@index([purchaseId])
}

enum PurchaseReturnStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model PurchaseReturnItem {
  id               String   @id @default(cuid())
  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseItemId   String?
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  quantity         Decimal  @db.Decimal(12, 3)
  refundAmount     Decimal  @default(0) @db.Decimal(12, 2)
  reason           String?
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Decimal  @db.Decimal(12, 3)
  returnedQty Decimal  @default(0) @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  discount   Decimal  @default(0) @db.Decimal(12, 2)
  tax        Decimal  @default(0) @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
}

model Sale {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  invoiceNo     String
  saleDate      DateTime @default(now())
  subtotal      Decimal  @default(0) @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  tax           Decimal  @default(0) @db.Decimal(12, 2)
  total         Decimal  @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal  @default(0) @db.Decimal(12, 2)
  dueAmount     Decimal  @default(0) @db.Decimal(12, 2)
  paymentMethod String   @default("cash")
  paymentStatus      SalePaymentStatus @default(PAID)
  status             SaleStatus @default(COMPLETED)
  deliveryStatus     String?
  cancellationReason String?  @db.Text
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items        SaleItem[]
  payments     CustomerPayment[]
  saleReturns  SaleReturn[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, saleDate])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([branchId])
}

enum SalePaymentStatus {
  PAID
  PARTIAL
  DUE
}

enum SaleStatus {
  COMPLETED
  HELD
  RETURNED
  CANCELLED
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Decimal @db.Decimal(12, 3)
  returnedQty Decimal @default(0) @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  tax         Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  saleReturnItems SaleReturnItem[]
}

model SaleReturn {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  returnNo     String
  returnDate   DateTime @default(now())
  status       SaleReturnStatus @default(DRAFT)
  refundAmount Decimal  @default(0) @db.Decimal(12, 2)
  refundStatus String   @default("pending")
  reason       String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items SaleReturnItem[]

  @@unique([tenantId, returnNo])
  @@index([tenantId, returnDate])
  @@index([saleId])
  @@index([customerId])
}

enum SaleReturnStatus {
  DRAFT
  PENDING
  COMPLETED
  CANCELLED
  REJECTED
}

model SaleReturnItem {
  id           String   @id @default(cuid())
  saleReturnId String
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItemId   String?
  saleItem     SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: SetNull)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Decimal  @db.Decimal(12, 3)
  refundAmount Decimal  @default(0) @db.Decimal(12, 2)
  reason       String?
}

model StockMovement {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?  @relation(fields: [branchId], references: [id])
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  type             StockMovementType
  quantity         Decimal  @db.Decimal(12, 3)
  reference        String?
  reason           String?
  notes            String?
  status           StockMovementStatus @default(APPROVED)
  parentMovementId String?
  parentMovement   StockMovement? @relation("MovementReversal", fields: [parentMovementId], references: [id], onDelete: SetNull)
  reversals        StockMovement[] @relation("MovementReversal")
  reversedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([tenantId, productId])
  @@index([tenantId, status])
}

enum StockMovementStatus {
  PENDING
  APPROVED
  REVERSED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  OPENING
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  DAMAGE
  EXPIRED
}

model StockTransfer {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBranchId    String?
  fromBranch      Branch?  @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId      String
  toBranch        Branch   @relation("TransferTo", fields: [toBranchId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Decimal  @db.Decimal(12, 3)
  status          StockTransferStatus @default(PENDING)
  reference       String
  notes           String?
  requestedById   String?
  requestedBy     User?    @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedById    String?
  approvedBy      User?    @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

enum StockTransferStatus {
  PENDING
  APPROVED
  REJECTED
  RECEIVED
  CANCELLED
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  expenses Expense[]

  @@unique([tenantId, name])
}

model Expense {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  categoryId    String?
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id])
  title         String
  amount        Decimal  @db.Decimal(12, 2)
  expenseDate   DateTime @default(now())
  paymentMethod String?  @default("cash")
  attachment    String?
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, expenseDate])
  @@index([branchId])
  @@index([tenantId, deletedAt])
}
