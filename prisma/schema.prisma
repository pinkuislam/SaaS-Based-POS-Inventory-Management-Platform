generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
}

// ============ MASTER / SAAS ============

model SuperAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionPackage {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?  @db.Text
  price         Decimal  @db.Decimal(12, 2)
  billingCycle  String   @default("monthly") // monthly, yearly
  trialDays     Int      @default(0)
  maxUsers      Int      @default(2)
  maxBranches   Int      @default(1)
  maxProducts   Int      @default(500)
  maxInvoices   Int      @default(1000)
  graceDays     Int      @default(7)
  features      Json     @default("[]")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  tenants       Tenant[]
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  email       String
  phone       String?
  address     String?  @db.Text
  logo        String?
  status      TenantStatus @default(PENDING)
  dbName      String?
  dbProvisioned Boolean @default(false)
  settings    Json     @default("{}")
  packageId   String?
  package     SubscriptionPackage? @relation(fields: [packageId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
  users           User[]
  branches        Branch[]
  roles           Role[]
  categories      ProductCategory[]
  brands          Brand[]
  units           Unit[]
  products        Product[]
  customerGroups  CustomerGroup[]
  customers       Customer[]
  suppliers       Supplier[]
  purchases       Purchase[]
  sales           Sale[]
  expenses        Expense[]
  expenseCategories ExpenseCategory[]
  stockMovements  StockMovement[]
  supportTickets  SupportTicket[]
  customerPayments CustomerPayment[]
  supplierPayments SupplierPayment[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  ecommerceSetting EcommerceSetting?
  onlineOrders     OnlineOrder[]
  loginLogs        LoginLog[]
  apiKeys          TenantApiKey[]
}

model TenantApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  keyPrefix  String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

model LoginLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  email     String
  success   Boolean
  ip        String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
}

model EcommerceSetting {
  id             String    @id @default(cuid())
  tenantId       String    @unique
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform       String    @default("woocommerce")
  storeUrl       String
  consumerKey    String    @db.Text
  consumerSecret String    @db.Text
  isActive       Boolean   @default(false)
  syncProducts   Boolean   @default(true)
  syncStock      Boolean   @default(true)
  syncOrders     Boolean   @default(true)
  lastProductSync DateTime?
  lastOrderSync  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model OnlineOrder {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId    String
  platform      String   @default("woocommerce")
  orderNumber   String
  customerName  String?
  customerEmail String?
  total         Decimal  @db.Decimal(12, 2)
  status        String
  saleId        String?
  orderDate     DateTime
  syncedAt      DateTime @default(now())

  @@unique([tenantId, platform, externalId])
  @@index([tenantId, orderDate])
}

model ActivityLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String?
  action    String
  module    String
  details   String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([module])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String   @default("info")
  title     String
  message   String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId, isRead])
  @@index([tenantId, type])
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
}

model Subscription {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packageId String
  package   SubscriptionPackage @relation(fields: [packageId], references: [id])
  startDate DateTime @default(now())
  endDate   DateTime
  status    SubscriptionStatus @default(ACTIVE)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments SubscriptionPayment[]
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

model SubscriptionPayment {
  id             String   @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Decimal  @db.Decimal(12, 2)
  method         String?
  transactionId  String?
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime @default(now())
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model SupportTicket {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject   String
  message   String   @db.Text
  status    String   @default("open")
  priority  String   @default("medium")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

model BillingCheckout {
  id             String   @id @default(cuid())
  tenantId       String
  subscriptionId String?
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("USD")
  gateway        String
  externalRef    String?
  status         String   @default("pending")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, status])
  @@index([externalRef])
}

// ============ TENANT DATA ============

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  permissions Json     @default("[]")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@unique([tenantId, name])
}

model User {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId    String?
  role      Role?    @relation(fields: [roleId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  email     String
  password  String
  name      String
  phone     String?
  isActive  Boolean  @default(true)
  userType  UserType @default(TENANT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     Sale[]
  purchases Purchase[]

  @@unique([email, tenantId])
  @@index([tenantId])
}

enum UserType {
  SUPER_ADMIN
  TENANT
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  address   String?  @db.Text
  phone     String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  products  Product[]
  sales     Sale[]
  purchases Purchase[]
  stockMovements StockMovement[]

  @@unique([tenantId, code])
}

model ProductCategory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    ProductCategory? @relation("CategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryTree")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([tenantId, name])
}

model Brand {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([tenantId, name])
}

model Unit {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  shortName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([tenantId, name])
}

model Product {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  categoryId    String?
  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?   @relation(fields: [brandId], references: [id])
  unitId        String?
  unit          Unit?    @relation(fields: [unitId], references: [id])
  name          String
  sku           String?
  barcode       String?
  purchasePrice Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice  Decimal  @default(0) @db.Decimal(12, 2)
  wholesalePrice Decimal? @db.Decimal(12, 2)
  taxRate       Decimal  @default(0) @db.Decimal(5, 2)
  stockQty      Decimal  @default(0) @db.Decimal(12, 3)
  reorderLevel  Decimal  @default(0) @db.Decimal(12, 3)
  expiryDate    DateTime?
  batchNo       String?
  image         String?
  description   String?  @db.Text
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  stockMovements StockMovement[]

  @@index([tenantId, barcode])
  @@index([tenantId, sku])
  @@index([tenantId, name])
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model CustomerGroup {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?  @db.Text
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customers Customer[]

  @@unique([tenantId, name])
}

model Customer {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId        String?
  group          CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name           String
  phone          String?
  email          String?
  address        String?  @db.Text
  customerType   String   @default("retail")
  openingBalance Decimal  @default(0) @db.Decimal(12, 2)
  creditLimit    Decimal  @default(0) @db.Decimal(12, 2)
  loyaltyPoints  Int      @default(0)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales    Sale[]
  payments CustomerPayment[]

  @@index([tenantId, phone])
  @@index([tenantId, groupId])
}

model CustomerPayment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saleId      String?
  sale        Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  amount      Decimal  @db.Decimal(12, 2)
  method      String   @default("cash")
  paymentDate DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())

  @@index([tenantId, customerId])
  @@index([saleId])
}

model Supplier {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  companyName    String?
  phone          String?
  email          String?
  address        String?  @db.Text
  openingBalance Decimal  @default(0) @db.Decimal(12, 2)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchases Purchase[]
  payments  SupplierPayment[]

  @@index([tenantId])
}

model SupplierPayment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseId  String?
  amount      Decimal  @db.Decimal(12, 2)
  method      String   @default("cash")
  paymentDate DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())

  @@index([tenantId, supplierId])
}

model Purchase {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  invoiceNo     String
  purchaseDate  DateTime @default(now())
  subtotal      Decimal  @default(0) @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  tax           Decimal  @default(0) @db.Decimal(12, 2)
  total         Decimal  @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal  @default(0) @db.Decimal(12, 2)
  dueAmount     Decimal  @default(0) @db.Decimal(12, 2)
  paymentStatus PurchasePaymentStatus @default(DUE)
  status        PurchaseStatus @default(COMPLETED)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items PurchaseItem[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, purchaseDate])
  @@index([supplierId])
}

enum PurchasePaymentStatus {
  PAID
  PARTIAL
  DUE
}

enum PurchaseStatus {
  COMPLETED
  RETURNED
  CANCELLED
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Decimal  @db.Decimal(12, 3)
  returnedQty Decimal  @default(0) @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  discount   Decimal  @default(0) @db.Decimal(12, 2)
  tax        Decimal  @default(0) @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
}

model Sale {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  invoiceNo     String
  saleDate      DateTime @default(now())
  subtotal      Decimal  @default(0) @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  tax           Decimal  @default(0) @db.Decimal(12, 2)
  total         Decimal  @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal  @default(0) @db.Decimal(12, 2)
  dueAmount     Decimal  @default(0) @db.Decimal(12, 2)
  paymentMethod String   @default("cash")
  paymentStatus SalePaymentStatus @default(PAID)
  status        SaleStatus @default(COMPLETED)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items    SaleItem[]
  payments CustomerPayment[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, saleDate])
}

enum SalePaymentStatus {
  PAID
  PARTIAL
  DUE
}

enum SaleStatus {
  COMPLETED
  HELD
  RETURNED
  CANCELLED
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Decimal @db.Decimal(12, 3)
  returnedQty Decimal @default(0) @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  tax         Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
}

model StockMovement {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  type        StockMovementType
  quantity    Decimal  @db.Decimal(12, 3)
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([tenantId, productId])
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  DAMAGE
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  expenses Expense[]

  @@unique([tenantId, name])
}

model Expense {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id])
  title      String
  amount     Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, expenseDate])
}
